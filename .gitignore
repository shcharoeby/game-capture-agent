# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
*.egg

# ── Virtual envs ──────────────────────────────────────────────────────────────
venv/
.venv/
env/
.env

# ── PyInstaller build artifacts ───────────────────────────────────────────────
build/

# ── Vendor binaries (download manually per vendor/README.md) ─────────────────
vendor/ffmpeg.exe
vendor/ffmpeg
vendor/*.exe
vendor/*.dmg
vendor/*.tar.gz
vendor/*.zip

# ── User config — contains stream keys, stored in %APPDATA%\GameCapture ──────
config.yaml

# ── Runtime logs ──────────────────────────────────────────────────────────────
logs/
*.jsonl

# ── Inno Setup built installer (generated by release.sh, uploaded to GitHub) ──
installer/GameCapture-Setup-*.exe
installer/Output/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
